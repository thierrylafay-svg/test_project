{
  "manifest_version": 3,
  "name": "Assistant de navigation",
  "version": "0.1.0",
  "description": "Aide à la démarche : posez une question, l'assistant surligne où agir.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://api.mistral.ai/*",
    "http://localhost:5500/*",
    "https://www.mon-site-demarche.fr/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost:5500/*", "https://www.mon-site-demarche.fr/*"],
      "js": ["content/extracteur.js", "lib/validation.js", "lib/prompt.js", "content/overlay.js", "content/orchestrateur.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {}
}